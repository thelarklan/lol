pipeline {
    agent any
    stages {
        stage('Credentials') {
            steps {
                withCredentials([
                    string(credentialsId: 'fixture-text', variable: 'TEXT_SECRET'),
                    usernamePassword(
                        credentialsId: 'fixture-userpass',
                        usernameVariable: 'FIXTURE_USER',
                        passwordVariable: 'FIXTURE_PASSWORD'
                    )
                ]) {
                    sh 'test "$TEXT_SECRET" = text-value'
                    sh 'test "$FIXTURE_USER:$FIXTURE_PASSWORD" = fixture-user:password-value'
                    sh 'printf "%s:%s\\n" "$TEXT_SECRET" "$FIXTURE_PASSWORD"'
                }
            }
        }
    }
}
