pipeline {
    agent any
    parameters {
        string(name: 'GREETING', defaultValue: 'hello')
        booleanParam(name: 'ENABLED', defaultValue: true)
        password(name: 'TOKEN', defaultValue: '')
    }
    stages {
        stage('Parameters') {
            steps { echo "${params.GREETING}:${params.ENABLED}:${params.TOKEN}" }
        }
    }
}
